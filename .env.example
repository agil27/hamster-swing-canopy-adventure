# Copy to .env for local dev. On Render, set these as real environment
# variables in the service's dashboard instead (see render.yaml).

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application).
# Add your dev origin (e.g. http://localhost:5173) and your production
# origin as Authorized JavaScript origins. The client is public — it's
# meant to ship in the frontend bundle too (see VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite file lives. Defaults to server/data/hamswing.db if unset
# — fine for local dev. On Render's free plan (see render.yaml) this is
# left unset on purpose: there's no persistent disk, so the DB lives on
# the container's own ephemeral filesystem and resets on every deploy and
# every spin-down/spin-up. To make it durable later, add a paid plan +
# disk in render.yaml and point this at the mounted path.
DB_PATH=

# Same Client ID as above, exposed to the frontend build (Vite only
# inlines vars prefixed VITE_). Must match GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
