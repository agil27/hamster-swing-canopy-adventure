# Copy to .env for local dev. On Render, set these as real environment
# variables in the service's dashboard instead (see render.yaml).

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application).
# Add your dev origin (e.g. http://localhost:5173) and your production
# origin as Authorized JavaScript origins. Set this ONE variable only —
# vite.config.ts bakes it into the frontend bundle at build time (as
# __GOOGLE_CLIENT_ID__) from the same value the server verifies tokens
# against, so there's nothing to duplicate.
GOOGLE_CLIENT_ID=

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Free hosted libSQL (Turso) database — this is what actually persists
# accounts/scores across deploys and spin-downs on Render's free plan
# (there's no disk to lose data from in the first place). Get both from
# https://turso.tech (free tier, no card needed):
#   turso db create hamswing
#   turso db show hamswing --url          -> TURSO_DATABASE_URL
#   turso db tokens create hamswing        -> TURSO_AUTH_TOKEN
# Leave both unset for local dev — server/db.js then falls back to a
# plain local SQLite file (server/data/hamswing.db), no account needed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Overrides where that local-fallback SQLite file lives (only used when
# TURSO_DATABASE_URL above is unset). Defaults to server/data/hamswing.db.
DB_PATH=
